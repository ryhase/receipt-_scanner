# OpenAI API key. Never expose this value to the browser or commit it.
OPENAI_API_KEY=your_openai_api_key
OPENAI_RECEIPT_MODEL=gpt-4o-mini

# Google Cloud service account that has Editor access to the target spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
# Preserve literal \n when putting a PEM key in an environment variable.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
